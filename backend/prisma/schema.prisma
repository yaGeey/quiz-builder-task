generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Quiz {
  id        Int        @id @default(autoincrement())
  title     String
  questions Question[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Question {
  id      Int     @id @default(autoincrement())
  quizId  Int
  quiz    Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type    String
  text    String
  options String?
  answers String?
}
